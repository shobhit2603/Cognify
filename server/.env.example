PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string

CLIENT_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT Secrets (Generate secure random strings for these)
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Token Configuration
ACCESS_TOKEN_EXPIRY=600m
REFRESH_TOKEN_EXPIRY=7d
ACCESS_TOKEN_COOKIE_MAX_AGE=900000
REFRESH_TOKEN_COOKIE_MAX_AGE=604800000

# API Keys
MISTRAL_API_KEY=your_mistral_api_key
PINECONE_API_KEY=your_pinecone_api_key
TAVILY_API_KEY=your_tavily_api_key

# Email/SMTP Configuration
SMTP_EMAIL=your_smtp_email_address
SMTP_APP_PASSWORD=your_smtp_app_password